{ 

    "$schema": "https://opencode.ai/config.json", 
    "mcp": { 
        "chrome-devtools": { 
            "type": "local", 
            "command": [ 
                "npx", 
                "-y", 
                "chrome-devtools-mcp@latest", 
                "--no-usage-statistics",
                "--browserUrl=http://127.0.0.1:9222"
            ] 
        }, 
        "context7": { 
            "type": "remote", 
            "url": "https://mcp.context7.com/mcp", 
            "headers": { 
                "CONTEXT7_API_KEY": "<TU APIKEY DE CONTEXT7>" 
            } 
        } 
    }
}